{
  "statusLine": { "type": "command", "command": "$HOME/.local/bin/tmux-agent-status title" },
  "hooks": {
    "SessionStart": [{ "hooks": [{ "type": "command", "command": "$HOME/.local/bin/tmux-agent-status idle claude" }] }],
    "UserPromptSubmit": [{ "hooks": [{ "type": "command", "command": "$HOME/.local/bin/tmux-agent-status working claude" }, { "type": "command", "command": "$HOME/.local/bin/tmux-agent-prompt set" }] }],
    "PermissionRequest": [{ "hooks": [{ "type": "command", "command": "$HOME/.local/bin/tmux-agent-status waiting claude" }] }],
    "PostToolUse": [{ "hooks": [{ "type": "command", "command": "$HOME/.local/bin/tmux-agent-status tool claude" }] }],
    "Stop": [{ "hooks": [{ "type": "command", "command": "if jq -e '(.background_tasks // []) == []' >/dev/null; then $HOME/.local/bin/tmux-agent-status done claude; fi" }] }],
    "SessionEnd": [{ "hooks": [{ "type": "command", "command": "$HOME/.local/bin/tmux-agent-status clear" }] }]
  }
}
