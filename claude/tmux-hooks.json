{
  "hooks": {
    "SessionStart": [{ "hooks": [{ "type": "command", "command": "$HOME/.local/bin/tmux-agent-status idle claude" }] }],
    "UserPromptSubmit": [{ "hooks": [{ "type": "command", "command": "$HOME/.local/bin/tmux-agent-status working claude" }] }],
    "PermissionRequest": [{ "hooks": [{ "type": "command", "command": "$HOME/.local/bin/tmux-agent-status waiting claude" }] }],
    "PostToolUse": [{ "hooks": [{ "type": "command", "command": "$HOME/.local/bin/tmux-agent-status working claude" }] }],
    "Stop": [{ "hooks": [{ "type": "command", "command": "$HOME/.local/bin/tmux-agent-status done claude" }] }],
    "SessionEnd": [{ "hooks": [{ "type": "command", "command": "$HOME/.local/bin/tmux-agent-status clear" }] }]
  }
}
